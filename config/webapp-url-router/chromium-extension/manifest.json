{
  "manifest_version": 3,
  "name": "Omarchy Slack Window Reuse",
  "version": "2.0",
  "description": "Navigates the open Slack web app window to deep links handed over from Zen instead of opening a second --app window.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "*://*.slack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
