[core]
  autocrlf = input
	editor = code --wait

[color]
  diff = auto
  status = auto
  branch = auto

[merge]
  ff = false

[pull]
	rebase = true

[gpg]
  format = ssh

# Written by scripts/setup_git.sh from config_local; config_work points work
# repos at allowed_signers_work so their signatures show the work email
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[credential]
  helper = store

[include]
  path = ~/.config/git/config_local
[safe]
	directory = ~/Code
[init]
	defaultBranch = main
