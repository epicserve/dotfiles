#!/bin/sh
# Exit 0 when a forwarded SSH agent is reachable at ~/.ssh/agent.sock
# (published by config/zsh/ssh_agent.zsh on every SSH login).
# ssh-add exits 1 when the agent has no keys, which still means it is alive.
# When the laptop sleeps, its SSH session can outlive it: the socket accepts
# connections but never answers, so give up quickly rather than hang.
sock="$HOME/.ssh/agent.sock"
[ -S "$sock" ] || exit 1
SSH_AUTH_SOCK="$sock" timeout 3 ssh-add -l >/dev/null 2>&1
[ $? -le 1 ]
