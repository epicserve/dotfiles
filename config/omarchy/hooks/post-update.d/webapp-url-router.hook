#!/bin/bash
# Re-apply the Slack web-app URL router after `omarchy update`: migrations can
# rewrite ~/.config/chromium-flags.conf or Slack.desktop, and the setup script
# restores both without touching the network unless something changed.
# Symlinked into ~/.config/omarchy/hooks/post-update.d/ by setup_omarchy.sh.
exec sh "$HOME/.dotfiles/scripts/setup_webapp_url_router.sh"
